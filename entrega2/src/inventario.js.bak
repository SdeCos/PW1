/*
 * inventario.js
 * Módulo de gestión de inventario de «La Tiendecita».
 *
 * Escrito en 2012. Funciona, está en producción y nadie se atreve a tocarlo.
 * Hoy le toca a usted.
 */

var IVA = 0.21;

// La tienda por defecto se crea al cargar el módulo.
var TIENDA_POR_DEFECTO = crearTienda('Sin nombre');


/* ---------- Productos ---------- */

function Producto(nombre, precio, stock) {
  this.nombre = nombre;
  this.precio = precio;
  this.stock = stock;
}

Producto.prototype.precioConIva = function () {
  return Math.round(this.precio * (1 + IVA) * 100) / 100;
};

Producto.prototype.descripcion = function () {
  return this.nombre + ' (' + this.precioConIva() + ' €)';
};


/* ---------- Utilidades ---------- */

// Devuelve el valor, o el valor por defecto si no hay valor.
function valorPorDefecto(valor, porDefecto) {
  if (valor == null) {
    return porDefecto;
  }
  return valor;
}

// Suma todos los números que se le pasen.
function sumar() {
  var total = 0;
  for (var i = 0; i < arguments.length; i++) {
    total += arguments[i];
  }
  return total;
}

// Etiqueta de disponibilidad según el stock.
function clasificar(stock) {
  if (stock === 0) {
    var estado = 'agotado';
  } else if (stock < 5) {
    var estado = 'pocas unidades';
  }
  return estado || 'disponible';
}

// Crea una función de aviso por cada producto.
function crearAvisos(nombres) {
  var avisos = [];
  for (var i = 0; i < nombres.length; i++) {
    (function (n) {
      avisos.push(function () {
        return 'Revisa el stock de ' + nombres[n];
      });
    })(i);
  }
  return avisos;
}


/* ---------- Listados ---------- */

function ordenarPorPrecio(lista) {
  return lista.sort(function (a, b) {
    return a.precio - b.precio;
  });
}

function masBarato(lista) {
  ordenarPorPrecio(lista);
  return lista[0];
}

function exportarCSV(lista) {
  var salida = 'nombre;precio;stock\n';
  for (var i = 0; i < lista.length; i++) {
    salida += lista[i].nombre + ';' + lista[i].precio + ';' + lista[i].stock + '\n';
  }
  return salida;
}


/* ---------- La tienda ---------- */

function crearTienda(nombre) {
  return {
    nombre: nombre,
    productos: [],
    anadir: function (producto) {
      this.productos.push(producto);
      return this;
    },
    resumen: function () {
      var self = this;
      return this.productos.map(function (p) {
        return self.nombre + ': ' + p.descripcion();
      });
    },
    valorTotal: function () {
      var total = 0;
      this.productos.forEach(function (p) {
        total += p.precioConIva() * p.stock;
      });
      return Math.round(total * 100) / 100;
    }
  };
}


module.exports = {
  IVA: IVA,
  TIENDA_POR_DEFECTO: TIENDA_POR_DEFECTO,
  Producto: Producto,
  valorPorDefecto: valorPorDefecto,
  sumar: sumar,
  clasificar: clasificar,
  crearAvisos: crearAvisos,
  ordenarPorPrecio: ordenarPorPrecio,
  masBarato: masBarato,
  exportarCSV: exportarCSV,
  crearTienda: crearTienda
};
